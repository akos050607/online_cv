    <script>
      const wrapper = document.getElementById("slide-fade-wrapper");
      const secProjects = document.getElementById("section-projects");
      const secTech = document.getElementById("section-tech");

      let currentProgress = 0;
      let targetProgress = 0;
      const ease = 0.08;
      const buffer = 0.1;
      let isUpdating = true;

      // Below 768px the two sections are a plain stacked scroll (see the
      // media query in global.css), and reduced-motion users never get the
      // slide-fade either. In both cases the driver must stop writing inline
      // transforms, or it fights the stylesheet.
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const stacked = window.matchMedia("(max-width: 767px)");
      const isStatic = () => reducedMotion.matches || stacked.matches;

      const clearInlineTransforms = () => {
        [secProjects, secTech].forEach((el) => {
          if (!el) return;
          el.style.opacity = "";
          el.style.transform = "";
        });
      };

      const calculateTarget = () => {
        if (!wrapper || isStatic()) return;
        const rect = wrapper.getBoundingClientRect();
        const viewportHeight = window.innerHeight;

        if (rect.top <= 0 && rect.bottom >= viewportHeight) {
          const scrollDistance = wrapper.offsetHeight - viewportHeight;
          const rawProgress = Math.abs(rect.top) / scrollDistance;
          let adjustedProgress = (rawProgress - buffer) / (1 - 2 * buffer);
          targetProgress = Math.max(0, Math.min(1, adjustedProgress));
        } else if (rect.top > 0) {
          targetProgress = 0;
        } else if (rect.bottom < viewportHeight) {
          targetProgress = 1;
        }

        isUpdating = true;
      };

      const renderSmoothAnim = () => {
        requestAnimationFrame(renderSmoothAnim);

        if (isStatic() || !isUpdating) return;

        if (Math.abs(targetProgress - currentProgress) > 0.001) {
          currentProgress += (targetProgress - currentProgress) * ease;
        } else {
          currentProgress = targetProgress;
          isUpdating = false;
        }

        if (secProjects && secTech) {
          secProjects.style.opacity = (1 - currentProgress).toString();
          secProjects.style.transform = `translate3d(-${currentProgress * 20}%, 0, 0) scale(${1 - currentProgress * 0.05})`;
          const slideInPosition = (1 - currentProgress) * 100;
          secTech.style.transform = `translate3d(${slideInPosition}%, 0, 0)`;
        }
      };

      const onViewportChange = () => {
        if (isStatic()) {
          clearInlineTransforms();
          return;
        }
        calculateTarget();
      };

      window.addEventListener("scroll", calculateTarget, { passive: true });
      window.addEventListener("resize", onViewportChange);
      reducedMotion.addEventListener("change", onViewportChange);
      stacked.addEventListener("change", onViewportChange);

      onViewportChange();
      renderSmoothAnim();

      // Case study modals. Any element with data-modal-open="<id>" opens that
      // dialog; anything with data-modal-close inside it closes the dialog.
      // While a dialog is open, focus is trapped inside it, and on close it
      // goes back to whichever trigger opened it.
      const FOCUSABLE =
        'a[href], button:not([disabled]), input, select, textarea, iframe, [tabindex]:not([tabindex="-1"])';

      // Every trigger pointing at a given modal, so aria-expanded stays in
      // sync no matter which one was used (the grid card and the role-fit row
      // open the same dialog).
      const triggersFor = (modal) =>
        modal
          ? document.querySelectorAll(`[data-modal-open="${modal.id}"]`)
          : [];

      let lastTrigger = null;

      const openModal = (modal, trigger) => {
        if (!modal || !modal.classList.contains("hidden")) return;
        lastTrigger = trigger ?? null;
        modal.classList.remove("hidden");
        modal.classList.add("flex");
        document.body.style.overflow = "hidden";
        triggersFor(modal).forEach((t) => t.setAttribute("aria-expanded", "true"));
        // Always open at the top, and focus without letting the browser scroll for us.
        const sheet = modal.querySelector(".case-modal-sheet");
        if (sheet) sheet.scrollTop = 0;
        modal.querySelector("button[data-modal-close]")?.focus({ preventScroll: true });
      };

      const closeModal = (modal) => {
        if (!modal || modal.classList.contains("hidden")) return;
        modal.classList.add("hidden");
        modal.classList.remove("flex");
        document.body.style.overflow = "";
        triggersFor(modal).forEach((t) => t.setAttribute("aria-expanded", "false"));
        lastTrigger?.focus({ preventScroll: true });
        lastTrigger = null;
      };

      document.querySelectorAll("[data-modal-open]").forEach((trigger) => {
        const modal = document.getElementById(
          trigger.getAttribute("data-modal-open"),
        );
        trigger.setAttribute("aria-expanded", "false");
        trigger.addEventListener("click", () => openModal(modal, trigger));
        trigger.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            openModal(modal, trigger);
          }
        });
      });

      document.querySelectorAll("[data-modal-close]").forEach((el) => {
        el.addEventListener("click", () => closeModal(el.closest(".case-modal")));
      });

      document.addEventListener("keydown", (e) => {
        const open = document.querySelector(".case-modal:not(.hidden)");
        if (!open) return;

        if (e.key === "Escape") {
          closeModal(open);
          return;
        }

        if (e.key !== "Tab") return;

        const items = Array.from(open.querySelectorAll(FOCUSABLE)).filter(
          (el) => el.offsetParent !== null || el === document.activeElement,
        );
        if (items.length === 0) return;

        const first = items[0];
        const last = items[items.length - 1];

        // Focus outside the sheet entirely (browser chrome, a stale target)
        // gets pulled back in rather than escaping to the page behind.
        if (!open.contains(document.activeElement)) {
          e.preventDefault();
          first.focus({ preventScroll: true });
        } else if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus({ preventScroll: true });
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus({ preventScroll: true });
        }
      });
    </script>
  </body>
</html>

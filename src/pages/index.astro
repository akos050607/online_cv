---
import "../styles/global.css";
import SystemCore from "../components/SystemCore.jsx";
import ProfileHologram from "../components/ProfileHologram.jsx";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Szénássy Ákos</title>
  </head>
  <body class="theme-body">
    <div class="dot-grid-overlay"></div>

    <main class="relative z-10 flex flex-col">
      <section class="section-container">
        <div
          class="max-w-[90rem] w-full grid grid-cols-1 lg:grid-cols-3 gap-6 md:gap-8"
        >
          <div class="glass-panel justify-center">
            <div class="mono-label-red">[ 01_Profile ]</div>
            <h1 class="heading-primary">Szénássy Ákos</h1>
            <p class="font-sans text-base text-gray-700 leading-relaxed mb-8">
              Computer Science Engineering student at BME.<br />
              Excellent problem-solving skills and a team-player mindset. My goal
              is to secure a challenging internship position.
            </p>
            <div
              class="font-mono text-[10px] md:text-xs text-gray-400 pt-4 border-t border-gray-200 mt-auto flex justify-between"
            >
              <span>LOC: Budapest</span>
              <a
                href="https://github.com/akos050607"
                target="_blank"
                class="hover:text-black transition-colors">GITHUB</a
              >
            </div>
          </div>

          <div
            class="bg-gray-100 border border-gray-300 flex items-center justify-center overflow-hidden shadow-sm relative"
          >
            <ProfileHologram client:only="react" />
          </div>

          <div class="glass-panel justify-between group">
            <div class="flex items-center justify-between relative z-10 mb-8">
              <div class="mono-label !mb-0">[ Status ]</div>
            </div>

            <div
              class="absolute right-[-10%] top-1/2 -translate-y-1/2 w-[250px] md:w-[350px] h-[250px] md:h-[350px] opacity-60 group-hover:opacity-100 transition-opacity pointer-events-none"
            >
              <SystemCore client:only="react" />
            </div>

            <div class="relative z-10 mt-auto">
              <div class="font-serif text-3xl md:text-4xl mb-4 leading-tight">
                Available<br />for Internship
              </div>
              <div class="flex items-center gap-2 mb-6">
                <div class="w-2 h-2 rounded-full bg-nothing-red animate-pulse">
                </div>
              </div>
              <a
                href="mailto:szenassy.akos5@gmail.com"
                class="font-mono text-xs md:text-sm border-b border-black pb-1 hover:text-nothing-red hover:border-nothing-red transition-colors inline-block"
              >
                [ CONTACT_ME ]
              </a>
            </div>
          </div>
        </div>
        <div
          class="absolute bottom-4 md:bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center justify-center z-20"
        >
          <div
            class="font-mono text-[10px] md:text-xs text-black font-bold tracking-[0.4em] uppercase mb-2 md:mb-3 animate-pulse drop-shadow-[0_0_8px_rgba(255,255,255,0.6)]"
          >
            Scroll
          </div>
          <div
            class="w-[2px] h-12 md:h-16 bg-gray-600 relative overflow-hidden rounded-full"
          >
            <div
              class="w-full h-1/3 bg-nothing-red absolute top-0 hardware-drop shadow-[0_0_10px_rgba(204,0,0,0.8)]"
            >
            </div>
          </div>
        </div>
      </section>

      <div id="slide-fade-wrapper" class="relative h-[400vh] w-full bg-black">
        <div class="sticky top-0 h-screen w-full overflow-hidden bg-black">
          <section
            id="section-projects"
            class="absolute inset-0 w-full h-full bg-black text-white flex items-center justify-center p-6 md:p-12 will-change-transform"
          >
            <div
              class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 opacity-5 font-serif text-[15vw] leading-none pointer-events-none whitespace-nowrap"
            >
              PROJECTS
            </div>

            <div
              class="max-w-[90rem] w-full relative z-10 flex flex-col justify-center h-full py-20"
            >
              <div class="mono-label text-center !text-gray-400">
                [ 02_Projects_Hub ]
              </div>

              <div class="project-grid">
                <a
                  href="https://github.com/akos050607/K3d-chaos-cluster"
                  target="_blank"
                  class="project-card project-card-large group relative overflow-hidden flex flex-col justify-end min-h-[300px] md:min-h-[400px] p-0 border border-gray-800"
                >
                  <img
                    src="/images/kubernetes.png"
                    alt="K3d Chaos Cluster Preview"
                    class="absolute inset-0 w-full h-full object-cover z-0 opacity-20 grayscale group-hover:opacity-50 group-hover:grayscale-0 transition-all duration-700"
                  />

                  <div
                    class="absolute inset-0 z-[1] bg-gradient-to-t from-black via-black/80 to-transparent group-hover:via-black/50 transition-all duration-500"
                  >
                  </div>

                  <div
                    class="relative z-10 p-6 md:p-8 flex flex-col h-full justify-end"
                  >
                    <div>
                      <h3
                        class="project-title md:text-3xl text-white group-hover:text-nothing-red transition-colors duration-300 mb-3"
                      >
                        K3d-chaos-cluster
                      </h3>
                      <p
                        class="font-sans text-sm md:text-base text-gray-400 group-hover:text-gray-300 transition-colors duration-300"
                      >
                        A practical lab demonstrating a zero-trust hybrid
                        Kubernetes cluster (K3s + Tailscale) with chaos
                        engineering, self-healing, and HPA auto-scaling across
                        cloud and edge nodes.
                      </p>
                    </div>
                    <span
                      class="project-link mt-8 text-gray-500 group-hover:text-white transition-colors duration-300"
                      >GITHUB -></span
                    >
                  </div>
                </a>

                <a
                  href="https://smartchaincontrol.szenassy-akos.com"
                  target="_blank"
                  class="project-card project-card-wide group relative overflow-hidden flex flex-col justify-end min-h-[300px] md:min-h-[190px] p-0 border border-gray-800"
                >
                  <div
                    class="absolute inset-0 z-0 opacity-60 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
                  >
                    <div class="w-[200%] h-[200%] origin-top-left scale-50">
                      <iframe
                        src="https://smartchaincontrol.szenassy-akos.com"
                        class="w-full h-full border-none"
                        loading="lazy"
                        title="SmartChainControl Live Preview"
                      >
                      </iframe>
                    </div>
                  </div>

                  <div
                    class="absolute inset-0 z-[1] bg-gradient-to-t from-black via-black/40 to-transparent group-hover:via-black/20 transition-all duration-500"
                  >
                  </div>

                  <div
                    class="relative z-10 p-6 flex flex-col h-full justify-end"
                  >
                    <div
                      class="bg-black/40 backdrop-blur-[2px] p-4 rounded-lg border border-white/5 inline-block max-w-[80%]"
                    >
                      <h3
                        class="project-title text-xl text-white mb-2 group-hover:text-nothing-red transition-colors"
                      >
                        SmartChainControl
                      </h3>
                      <p
                        class="font-sans text-sm text-gray-200 leading-relaxed"
                      >
                        Real-time Digital Twin Warehouse Simulator built with
                        .NET 10, Blazor WebAssembly, and SignalR.
                      </p>
                    </div>

                    <div class="mt-4 flex items-center justify-between w-full">
                      <span
                        class="relative bg-black/80 px-3 py-1.5 rounded-md border border-gray-700 flex items-center gap-2 group-hover:border-nothing-red transition-colors"
                      >
                        <span
                          class="w-2 h-2 rounded-full bg-nothing-red animate-pulse"
                        ></span>
                        <span class="text-xs text-white font-mono">LIVE</span>
                      </span>

                      <span
                        class="font-mono text-gray-500 group-hover:text-white group-hover:translate-x-3 transition-all duration-300 text-3xl md:text-4xl font-bold"
                      >
                        ->
                      </span>
                    </div>
                  </div>
                </a>

                <div
                  id="streaming-card"
                  role="button"
                  tabindex="0"
                  aria-haspopup="dialog"
                  aria-controls="streaming-modal"
                  class="project-card project-card-wide group relative overflow-hidden flex flex-col justify-end min-h-[300px] md:min-h-[190px] p-0 border border-gray-800 cursor-pointer"
                >
                  <!-- Showcase backdrop: a faint network grid washed by a red
                       signal glow — evokes the tunnelled stream, no stock image. -->
                  <div
                    class="absolute inset-0 z-0 opacity-30 group-hover:opacity-60 transition-opacity duration-700 pointer-events-none"
                    style="background-image: radial-gradient(circle at 82% 18%, rgba(255,51,51,0.35), transparent 55%), linear-gradient(rgba(255,255,255,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.05) 1px, transparent 1px); background-size: 100% 100%, 26px 26px, 26px 26px;"
                  >
                  </div>

                  <div
                    class="absolute inset-0 z-[1] bg-gradient-to-t from-black via-black/70 to-transparent group-hover:via-black/45 transition-all duration-500"
                  >
                  </div>

                  <div class="relative z-10 p-6 flex flex-col h-full justify-end">
                    <div>
                      <h3
                        class="project-title text-xl text-white mb-2 group-hover:text-nothing-red transition-colors"
                      >
                        Ultra-Low Latency Remote Streaming
                      </h3>
                      <p
                        class="font-sans text-sm text-gray-400 group-hover:text-gray-300 transition-colors line-clamp-2"
                      >
                        Self-hosted Sunshine/Moonlight streaming tunneled out of a
                        university CGNAT firewall &mdash; a custom FRP reverse-proxy
                        through a Budapest BIX VPS, cutting 60ms+ to 15&ndash;22ms.
                      </p>
                    </div>

                    <div class="mt-5 flex flex-wrap items-center gap-2">
                      <span
                        class="font-mono text-[10px] uppercase tracking-wider text-white bg-black/60 border border-gray-700 px-2.5 py-1"
                        >15&ndash;22ms latency</span
                      >
                      <span
                        class="font-mono text-[10px] uppercase tracking-wider text-white bg-black/60 border border-gray-700 px-2.5 py-1"
                        >0.00% jitter</span
                      >
                      <span
                        class="font-mono text-[10px] uppercase tracking-wider text-nothing-red bg-black/60 border border-nothing-red/50 px-2.5 py-1 group-hover:bg-nothing-red group-hover:text-white transition-colors"
                        >Read Case Study -></span
                      >
                    </div>
                  </div>
                </div>

                <a
                  href="https://github.com/akos050607/SpendSmart"
                  target="_blank"
                  class="project-card project-card-normal group"
                >
                  <div>
                    <h3 class="project-title">SpendSmart</h3>
                    <p class="font-sans text-sm text-gray-400 line-clamp-4">
                      Automated expense tracking pipeline that extracts
                      structured data from receipt images using OCR/LLMs and
                      stores it in PostgreSQL for real-time Streamlit
                      visualization.
                    </p>
                  </div>
                  <span class="project-link">GITHUB -></span>
                </a>

                <a
                  href="https://github.com/akos050607/PremiereFlow"
                  target="_blank"
                  class="project-card project-card-normal group"
                >
                  <div>
                    <h3 class="project-title">PremiereFlow</h3>
                    <p class="font-sans text-sm text-gray-400 line-clamp-4">
                      Real-time cinema reservation system built with Spring Boot
                      and React, utilizing WebSockets for live seat updates and
                      optimistic locking to prevent double-booking.
                    </p>
                  </div>
                  <span class="project-link">GITHUB -></span>
                </a>
              </div>
            </div>
            <div
              class="absolute bottom-6 right-6 md:bottom-12 md:right-12 flex flex-col items-center z-50"
            >
              <div
                class="font-mono text-[10px] text-gray-500 tracking-[0.2em] uppercase mb-3 animate-pulse"
                style="writing-mode: vertical-rl; transform: rotate(180deg);"
              >
                Scroll
              </div>
              <div
                class="w-[1px] h-12 md:h-16 bg-gray-800 relative overflow-hidden mt-1"
              >
                <div
                  class="w-full h-1/3 bg-nothing-red absolute top-0 hardware-drop"
                >
                </div>
              </div>
            </div>
          </section>

          <section
            id="section-tech"
            class="absolute inset-0 w-full h-full bg-white flex items-center justify-center p-6 md:p-12 will-change-transform translate-x-full shadow-[-20px_0_50px_rgba(0,0,0,0.5)]"
          >
            <div
              class="max-w-5xl w-full bg-gray-50 border border-gray-200 p-10 md:p-16 shadow-sm text-center"
            >
              <div class="mono-label-red !mb-10">[ 03_Tech_Stack ]</div>
              <div
                class="flex flex-wrap justify-center gap-4 md:gap-6 font-sans text-sm md:text-base"
              >
                <span class="tech-badge">C# / .NET 9/10</span>
                <span class="tech-badge">Java / Spring Boot</span>
                <span class="tech-badge"
                  >Angular / React / Blazor -> minimal</span
                >
                <span class="tech-badge">SQL</span>
                <span class="tech-badge">Kubernetes / Docker</span>
                <span class="tech-badge">WebSockets / SignalR</span>
                <span class="tech-badge">Cloud / CI/CD</span>
                <span class="tech-badge">Git / GitHub</span>
              </div>
            </div>
          </section>
        </div>
      </div>

      <section class="section-container bg-[#f4f4f4]">
        <div
          class="absolute inset-0 z-0 opacity-[0.08]"
          style="background-image: linear-gradient(#000 1px, transparent 1px), linear-gradient(90deg, #000 1px, transparent 1px); background-size: 40px 40px;"
        >
        </div>

        <div class="max-w-5xl w-full relative z-10 py-12">
          <div class="mono-label-red text-center !mb-16 md:!mb-24">
            [ 04_Journey ]
          </div>

          <div
            class="relative border-l border-gray-300 md:border-none pl-6 md:pl-0 ml-3 md:ml-0 space-y-12 md:space-y-16"
          >
            <div
              class="hidden md:block absolute left-[30%] top-0 bottom-[-3rem] w-[1px] bg-gray-300 -translate-x-1/2"
            >
            </div>

            <div class="journey-item group">
              <div
                class="journey-dot bg-nothing-red shadow-[0_0_8px_rgba(204,0,0,0.6)]"
              >
              </div>
              <div class="md:col-span-3 text-left md:text-right mt-1 md:mt-0">
                <div class="font-mono text-sm text-nothing-red mb-1">
                  Present
                </div>
                <div class="font-serif text-2xl">Bosch</div>
              </div>
              <div class="journey-panel group-hover:border-nothing-red">
                <h3 class="font-bold text-xl mb-3">
                  Software Developer Intern
                </h3>
                <p
                  class="text-gray-700 font-sans leading-relaxed text-sm md:text-base"
                >
                  Working as a software developer in an enterprise environment.
                  In my daily work, I use <strong>Go</strong>, <strong
                    >TypeScript</strong
                  >, and <strong>Svelte</strong> on live, corporate projects.
                </p>
              </div>
            </div>

            <div class="journey-item group">
              <div
                class="journey-dot bg-nothing-red shadow-[0_0_8px_rgba(204,0,0,0.6)]"
              >
              </div>
              <div class="md:col-span-3 text-left md:text-right mt-1 md:mt-0">
                <div class="font-mono text-sm text-nothing-red mb-1">
                  Sep 2024 - Present
                </div>
                <div class="font-serif text-2xl">BME</div>
              </div>
              <div class="journey-panel group-hover:border-nothing-red">
                <h3 class="font-bold text-xl mb-3">
                  Computer Science Engineering BSc Student
                </h3>
                <p
                  class="text-gray-700 font-sans leading-relaxed text-sm md:text-base"
                >
                  Alongside my internship, I am continuing my studies as an <strong
                    >active student</strong
                  >, deepening my theoretical foundations, software development
                  methodologies, and architecture design knowledge.
                </p>
              </div>
            </div>

            <div class="journey-item group">
              <div class="journey-dot bg-gray-400 group-hover:bg-black"></div>
              <div class="md:col-span-3 text-left md:text-right mt-1 md:mt-0">
                <div class="font-mono text-sm text-gray-500 mb-1">Ongoing</div>
                <div class="font-serif text-2xl text-gray-600">Projects</div>
              </div>
              <div class="journey-panel group-hover:border-black">
                <h3 class="font-bold text-xl text-gray-700 mb-3">
                  Personal Projects
                </h3>
                <p
                  class="text-gray-500 font-sans leading-relaxed text-sm md:text-base"
                >
                  Developing various complex personal projects (Kubernetes,
                  .NET, Spring Boot) to continuously broaden my perspective and
                  apply cutting-edge technologies.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="section-container bg-white">
        <div
          class="max-w-7xl w-full grid grid-cols-1 md:grid-cols-2 gap-16 md:gap-24 relative z-10 py-12"
        >
          <div class="border-t-2 border-black pt-8">
            <div class="mono-label-red !mb-8">[ 05_Language ]</div>
            <h3 class="heading-primary !mb-6">
              English <br />
            </h3>
            <div class="font-mono text-sm text-black mb-2">
              Confident communication
            </div>
            <div class="font-mono text-xs text-gray-500">
              In both professional and everyday environments.
            </div>
          </div>

          <div class="border-t-2 border-black pt-8">
            <div class="mono-label !mb-8">[ 06_Hobbies ]</div>
            <h3 class="heading-primary !mb-6">
              Gym <br />& <span class="text-gray-400">Running</span>
            </h3>

            <div class="font-mono text-xs text-gray-500">
              An active lifestyle to maintain focus and health.
            </div>
          </div>
        </div>
      </section>
    </main>
    <footer
      class="w-full bg-[#f4f4f4] border-t border-gray-300 py-6 px-4 z-20 relative"
    >
      <div
        class="max-w-5xl mx-auto flex flex-col items-center justify-center text-center gap-2"
      >
        <div
          class="font-mono text-[10px] text-gray-400 tracking-widest uppercase"
        >
          [ SYSTEM_DISCLAIMER ]
        </div>
        <p class="font-sans text-xs text-gray-500">
          Design language and aesthetic inspired by <a
            href="https://nothing.tech"
            target="_blank"
            rel="noopener noreferrer"
            class="text-nothing-red hover:underline font-bold">Nothing</a
          >.<br class="md:hidden" />
          This is an unofficial personal portfolio project. All design rights and
          trademarks belong to Nothing Technology Limited.
        </p>
      </div>
    </footer>

    <!-- Case study modal: full write-up for the remote-streaming project -->
    <div
      id="streaming-modal"
      class="fixed inset-0 z-[100] hidden items-center justify-center p-4 md:p-8"
      role="dialog"
      aria-modal="true"
      aria-labelledby="streaming-modal-title"
    >
      <div
        id="streaming-modal-backdrop"
        class="absolute inset-0 bg-black/80 backdrop-blur-sm"
      >
      </div>

      <div
        class="relative z-10 w-full max-w-3xl max-h-[88vh] overflow-y-auto bg-[#0a0a0a] border border-gray-800 text-white shadow-[0_0_60px_rgba(255,51,51,0.15)]"
      >
        <div
          class="sticky top-0 z-10 flex items-start justify-between gap-4 bg-[#0a0a0a]/95 backdrop-blur border-b border-gray-800 px-6 py-5 md:px-10"
        >
          <div>
            <div class="mono-label-red !mb-2">[ Case_Study ]</div>
            <h2
              id="streaming-modal-title"
              class="font-serif text-2xl md:text-3xl leading-tight"
            >
              Bypassing Enterprise NAT for Ultra-Low Latency Remote Streaming
            </h2>
          </div>
          <button
            id="streaming-modal-close"
            type="button"
            aria-label="Close case study"
            class="shrink-0 w-10 h-10 flex items-center justify-center border border-gray-700 text-gray-400 hover:border-nothing-red hover:text-nothing-red transition-colors font-mono text-lg"
          >
            ✕
          </button>
        </div>

        <div class="px-6 py-8 md:px-10 md:py-10 space-y-10">
          <div class="grid grid-cols-3 gap-3 text-center">
            <div class="border border-gray-800 p-3">
              <div class="font-mono text-lg md:text-xl text-nothing-red">
                15&ndash;22ms
              </div>
              <div
                class="font-mono text-[10px] uppercase tracking-wider text-gray-500 mt-1"
              >
                Latency
              </div>
            </div>
            <div class="border border-gray-800 p-3">
              <div class="font-mono text-lg md:text-xl text-nothing-red">
                0.00%
              </div>
              <div
                class="font-mono text-[10px] uppercase tracking-wider text-gray-500 mt-1"
              >
                Jitter
              </div>
            </div>
            <div class="border border-gray-800 p-3">
              <div class="font-mono text-lg md:text-xl text-nothing-red">
                ~40%
              </div>
              <div
                class="font-mono text-[10px] uppercase tracking-wider text-gray-500 mt-1"
              >
                Less Bandwidth
              </div>
            </div>
          </div>

          <section>
            <h3
              class="font-mono text-xs uppercase tracking-widest text-nothing-red mb-3"
            >
              The Challenge
            </h3>
            <p class="font-sans text-sm text-gray-300 leading-relaxed">
              Deploying a self-hosted, virtualized remote desktop environment
              capable of extremely low-latency (&lt;25ms) graphic streaming
              (Sunshine/Moonlight) behind a strict university enterprise firewall
              (CGNAT). The network strictly blocks inbound connections and
              utilizes aggressive UDP timeouts.
            </p>
          </section>

          <section>
            <h3
              class="font-mono text-xs uppercase tracking-widest text-nothing-red mb-3"
            >
              The Architecture &amp; Infrastructure
            </h3>
            <ul class="space-y-3 font-sans text-sm text-gray-300 leading-relaxed">
              <li class="border-l border-gray-800 pl-4">
                <span class="text-white font-medium">Hypervisor:</span> Proxmox VE
                running a dedicated Ubuntu 24.04 VM.
              </li>
              <li class="border-l border-gray-800 pl-4">
                <span class="text-white font-medium">Graphic Stack:</span> Nvidia
                hardware encoding (NVENC), testing HEVC/AV1 profiles, coupled with
                headless display emulation.
              </li>
              <li class="border-l border-gray-800 pl-4">
                <span class="text-white font-medium">Network Routing:</span> Nginx
                Proxy Manager for standard web services, alongside a custom
                tunneling solution for UDP/TCP game streaming traffic.
              </li>
              <li class="border-l border-gray-800 pl-4">
                <span class="text-white font-medium">Remote Gateway:</span> A
                lightweight Ubuntu VPS hosted in a Budapest datacenter with a
                direct connection to the BIX (Budapest Internet Exchange) backbone.
              </li>
            </ul>
          </section>

          <section>
            <h3
              class="font-mono text-xs uppercase tracking-widest text-nothing-red mb-4"
            >
              The Troubleshooting Journey
            </h3>

            <div class="border border-gray-800 p-5 mb-4">
              <h4 class="font-serif text-lg mb-2">
                Phase 1 &mdash; Mesh VPN &amp; UDP Hole Punching Failure
              </h4>
              <p class="font-sans text-sm text-gray-300 leading-relaxed mb-3">
                I initially deployed Tailscale to establish a direct P2P
                connection. While the initial handshake succeeded, the enterprise
                firewall quickly identified the high-bandwidth UDP stream and
                closed the hole-punching session.
              </p>
              <p class="font-sans text-sm text-gray-400 leading-relaxed">
                <span class="text-white font-medium">The Symptom:</span> Tailscale
                forcefully fell back to a secondary DERP relay server located in
                Frankfurt.
              </p>
              <p class="font-sans text-sm text-gray-400 leading-relaxed mt-2">
                <span class="text-white font-medium">The Impact:</span> Network
                latency spiked from an acceptable 18ms to an unplayable 60ms+,
                introducing massive jitter and packet loss due to the geographical
                detour (Budapest &rarr; Frankfurt &rarr; Budapest).
              </p>
            </div>

            <div class="border border-gray-800 p-5">
              <h4 class="font-serif text-lg mb-2">
                Phase 2 &mdash; The Reverse Proxy Tunnel (FRP) Injection
              </h4>
              <p class="font-sans text-sm text-gray-300 leading-relaxed mb-3">
                To eliminate the reliance on fragile UDP hole punching and bypass
                the firewall entirely, I re-architected the network flow using an
                FRP (Fast Reverse Proxy) tunnel.
              </p>
              <ul
                class="space-y-2 font-sans text-sm text-gray-400 leading-relaxed list-disc pl-5"
              >
                <li>
                  Configured the Rackforest VPS as the public entry point (frps).
                </li>
                <li>
                  Deployed an frpc client within the local Ubuntu VM, establishing
                  a persistent, outbound-only tunnel to the VPS.
                </li>
                <li>
                  Mapped the specific Sunshine ports (TCP: 47984, 47989, 48010;
                  UDP: 47998-48002, 48010) through the tunnel directly into the VM.
                </li>
              </ul>
            </div>
          </section>

          <section>
            <h3
              class="font-mono text-xs uppercase tracking-widest text-nothing-red mb-3"
            >
              Optimization &amp; Results
            </h3>
            <p class="font-sans text-sm text-gray-300 leading-relaxed mb-3">
              By routing the traffic through the local BIX backbone via the VPS,
              the geographic distance was minimized.
            </p>
            <ul class="space-y-3 font-sans text-sm text-gray-300 leading-relaxed">
              <li class="border-l border-nothing-red/60 pl-4">
                <span class="text-white font-medium">Latency:</span> Dropped
                consistently to 15&ndash;22ms on a 5G/remote wired connection.
              </li>
              <li class="border-l border-nothing-red/60 pl-4">
                <span class="text-white font-medium">Jitter:</span> Reduced to
                0.00%.
              </li>
              <li class="border-l border-nothing-red/60 pl-4">
                <span class="text-white font-medium">Bandwidth Management:</span>
                Discovered the ISP's 32GB outbound quota. Optimized the stream by
                switching to the AV1 encoder and reducing the resolution to
                1080p@120Hz, cutting the bandwidth requirement by ~40% (down to 12
                Mbps) without sacrificing perceived fluidity.
              </li>
            </ul>
          </section>

          <section>
            <h3
              class="font-mono text-xs uppercase tracking-widest text-nothing-red mb-3"
            >
              Key Takeaways &amp; DevOps Practices Applied
            </h3>
            <ul class="space-y-3 font-sans text-sm text-gray-300 leading-relaxed">
              <li class="border-l border-gray-800 pl-4">
                <span class="text-white font-medium"
                  >Infrastructure as Code (IaC):</span
                > Configured systemd services for both the FRP client and server to
                ensure automatic tunnel rebuilding upon VM/VPS reboots.
              </li>
              <li class="border-l border-gray-800 pl-4">
                <span class="text-white font-medium">Network Isolation:</span>
                Successfully segregated heavy UDP streaming traffic from standard
                HTTP/HTTPS web traffic handled by Nginx Proxy Manager.
              </li>
              <li class="border-l border-gray-800 pl-4">
                <span class="text-white font-medium"
                  >Deep Network Diagnostics:</span
                > Utilized internal metrics and CLI tools to identify the exact
                point of failure in the mesh VPN handshake and deployed a robust,
                production-ready reverse proxy alternative.
              </li>
            </ul>
          </section>
        </div>
      </div>
    </div>

    <script>
      const wrapper = document.getElementById("slide-fade-wrapper");
      const secProjects = document.getElementById("section-projects");
      const secTech = document.getElementById("section-tech");

      let currentProgress = 0;
      let targetProgress = 0;
      const ease = 0.08;
      const buffer = 0.1;
      let isUpdating = true;

      const calculateTarget = () => {
        if (!wrapper) return;
        const rect = wrapper.getBoundingClientRect();
        const viewportHeight = window.innerHeight;

        if (rect.top <= 0 && rect.bottom >= viewportHeight) {
          const scrollDistance = wrapper.offsetHeight - viewportHeight;
          const rawProgress = Math.abs(rect.top) / scrollDistance;
          let adjustedProgress = (rawProgress - buffer) / (1 - 2 * buffer);
          targetProgress = Math.max(0, Math.min(1, adjustedProgress));
        } else if (rect.top > 0) {
          targetProgress = 0;
        } else if (rect.bottom < viewportHeight) {
          targetProgress = 1;
        }

        isUpdating = true;
      };

      const renderSmoothAnim = () => {
        requestAnimationFrame(renderSmoothAnim);

        if (!isUpdating) return;

        if (Math.abs(targetProgress - currentProgress) > 0.001) {
          currentProgress += (targetProgress - currentProgress) * ease;
        } else {
          currentProgress = targetProgress;
          isUpdating = false;
        }

        if (secProjects && secTech) {
          secProjects.style.opacity = (1 - currentProgress).toString();
          secProjects.style.transform = `translate3d(-${currentProgress * 20}%, 0, 0) scale(${1 - currentProgress * 0.05})`;
          const slideInPosition = (1 - currentProgress) * 100;
          secTech.style.transform = `translate3d(${slideInPosition}%, 0, 0)`;
        }
      };

      window.addEventListener("scroll", calculateTarget, { passive: true });
      window.addEventListener("resize", calculateTarget);

      calculateTarget();
      renderSmoothAnim();

      // Remote-streaming case study modal
      const streamingCard = document.getElementById("streaming-card");
      const streamingModal = document.getElementById("streaming-modal");
      const streamingClose = document.getElementById("streaming-modal-close");
      const streamingBackdrop = document.getElementById(
        "streaming-modal-backdrop",
      );

      const openStreamingModal = () => {
        if (!streamingModal) return;
        streamingModal.classList.remove("hidden");
        streamingModal.classList.add("flex");
        document.body.style.overflow = "hidden";
      };
      const closeStreamingModal = () => {
        if (!streamingModal) return;
        streamingModal.classList.add("hidden");
        streamingModal.classList.remove("flex");
        document.body.style.overflow = "";
      };

      streamingCard?.addEventListener("click", openStreamingModal);
      streamingCard?.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          openStreamingModal();
        }
      });
      streamingClose?.addEventListener("click", closeStreamingModal);
      streamingBackdrop?.addEventListener("click", closeStreamingModal);
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && streamingModal && !streamingModal.classList.contains("hidden")) {
          closeStreamingModal();
        }
      });
    </script>
  </body>
</html>
